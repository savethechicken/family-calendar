# Copy to .env — calendar credentials live here, not in config.yaml.
# The server expands ${NAME} placeholders in config.yaml from these values.

# Google Calendar -> Settings -> Integrate calendar -> Secret address in iCal format
FAMILY_ICS_URL=
WORK_ICS_URL=
SCHOOL_ICS_URL=

# Optional: Google Calendar API source (see scripts/google_auth.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
